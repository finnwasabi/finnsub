PORT=3000
ADDRESS=localhost
BASE_URL=http://localhost:3000

DB_TYPE=sqlite
SQLITE_PATH=./data/database.db

#CORS proxy URL for Google Translate API
CORS_URL=http://cors-anywhere.herokuapp.com/

#FALSE MODE = in local you dont have public ip, so you cant publish to central, you plugin dont show in the stremio store
#TRUE MODE = in production you have public ip, so you can publish to central, and your plugin will show in the stremio store
PUBLISH_IN_STREMIO_STORE=FALSE

# So cau thoai gui trong mot luot goi. Lo lon it ton han muc hon, lo nho thi model nho
# it tra ve JSON vo hon. De trong thi dung 200, rieng ChatGPT API dung 50.
TRANSLATE_BATCH_SIZE=
# Nghi bao lau giua hai lo, tinh bang mili giay
TRANSLATE_BATCH_PAUSE_MS=4000
# Thu lai bao nhieu lan cho mot lo khi loi khong phai het han muc
TRANSLATE_MAX_RETRIES=3
# Bo bao lau thi thu lai model da bao het han muc, tinh bang mili giay
QUOTA_MEMORY_MS=3600000
# Ghi file go loi vao debug/ khi so dong tra ve khong khop. Chua toan bo loi thoai.
DEBUG_TRANSLATE=false
